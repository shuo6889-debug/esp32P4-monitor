// =============================================================================
//  .vscode/launch.json —— 调试配置（带注释副本）
// =============================================================================
//  作用：在 VS Code 里按 F5 时怎么启动调试器。
//  本工程只配了一条「附加（attach）」配置，含义是：
//  不负责烧录和启动，只连到一个「已经跑起来」的调试目标上。
//
//  使用前的准备（这是它能工作的前提）：
//    1. 硬件上接好 P4 的 USB-JTAG 调试口
//    2. 在 VS Code 的 ESP-IDF 面板里先点击 OpenOCD 启动调试服务器
//    3. 再按 F5 附加，之后才能打断点、看变量、看调用栈
//
//  和 idf.py monitor 的区别：
//    monitor 只能看日志（异步、简单）；
//    这里是真调试器，能停下来检查内存与变量（同步、强大但慢）。
// =============================================================================
{
  "version": "0.2.0",
  // ↑ 固定值，VS Code 调试协议的配置格式版本

  "configurations": [
    {
      "type": "gdbtarget",
      // ↑ 使用 GDB 通过 OpenOCD 连接目标的调试适配器类型

      "request": "attach",
      // ↑ attach = 附加上去；若换成 "launch" 则表示由调试器负责启动程序

      "name": "Eclipse CDT GDB Adapter"
      // ↑ 显示在调试下拉框里的名字，随便起
    }
  ]
}
